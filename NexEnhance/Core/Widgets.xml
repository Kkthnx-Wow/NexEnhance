<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!--
		Description paragraph for Blizzard's vertical Settings layout. Created via
		F.CreateSettingsDescription(text) (see Widgets.lua) and added to a
		subcategory layout with layout:AddInitializer(...). The mixin's Init reads
		the initializer data; height comes from the initializer's GetExtent.
	-->
	<Frame name="NexEnhanceSettingsDescriptionTemplate" virtual="true" mixin="NexEnhanceSettingsDescriptionMixin">
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
					<Anchors>
						<Anchor point="TOPLEFT" x="8" y="-4"/>
						<Anchor point="BOTTOMRIGHT" x="-26" y="4"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<!--
		Inline edit box row for Blizzard's vertical Settings layout. The edit box
		itself is created in Lua so it can reuse F.CreateEditBox and match the rest
		of NexEnhance's styled inputs.
	-->
	<Frame name="NexEnhanceSettingsEditBoxTemplate" virtual="true" mixin="NexEnhanceSettingsEditBoxMixin">
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Text" inherits="GameFontNormal" justifyH="LEFT" justifyV="TOP">
					<Anchors>
						<Anchor point="TOPLEFT" x="28" y="-4"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Description" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Text" relativePoint="BOTTOMLEFT" x="0" y="-3"/>
						<Anchor point="RIGHT" x="-26"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>
