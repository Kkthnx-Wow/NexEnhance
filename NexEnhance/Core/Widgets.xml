<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!--
		Description paragraph for Blizzard's vertical Settings layout. Created via
		F.CreateSettingsDescription(text) (see Widgets.lua) and added to a
		subcategory layout with layout:AddInitializer(...). The mixin's Init reads
		the initializer data; height comes from the initializer's GetExtent.
	-->
	<Frame name="NexEnhanceSettingsDescriptionTemplate" virtual="true" mixin="NexEnhanceSettingsDescriptionMixin">
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
					<Anchors>
						<Anchor point="TOPLEFT" x="8" y="-4"/>
						<Anchor point="BOTTOMRIGHT" x="-26" y="4"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>
