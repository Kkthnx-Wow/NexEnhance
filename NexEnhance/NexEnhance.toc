# ----------------------------------------------------------------------------
# Libraries (load before everything so the engine/modules can use them).
# ----------------------------------------------------------------------------
Libs\LibEditMode\LibStub\LibStub.lua
Libs\LibEditMode\embed.xml

# ----------------------------------------------------------------------------
# Core engine. Order matters: the engine must initialise the namespace before
# anything else consumes it, and the database must be ready before modules
# register their defaults.
# ----------------------------------------------------------------------------
Core\Engine.lua
Core\Constants.lua
Core\Functions.lua
Core\Widgets.lua
Core\API.lua
Core\Database.lua

# Localization (English is the fallback and must load first).
Core\Locales\enUS.lua

# User-facing entry points (slash commands + options panel).
Core\Commands.lua

# ----------------------------------------------------------------------------
# Modules. Each module is self-contained: it registers its own defaults,
# events and lifecycle callbacks through the engine API. Folders mirror the
# themed groups shown in the options panel.
# ----------------------------------------------------------------------------

# UI Scale (loads first so the pixel multiplier is ready before any backdrop).
Modules\Miscellaneous\UIScale.lua

# Action Bars
Modules\ActionBars\ActionBars.lua
Modules\ActionBars\Cooldowns.lua

# Unit Frames
Modules\UnitFrames\ClassColors.lua

# Auras
Modules\Auras\Reminder.lua

# Inventory
Modules\Inventory\ItemLevel.lua
Modules\Inventory\Durability.lua
Modules\Inventory\Mail.lua
Modules\Inventory\AlreadyKnown.lua

# Chat
Modules\Chat\Chat.lua
Modules\Chat\ChatCopy.lua
Modules\Chat\ChannelRename.lua

# Filters
Modules\Filters\ChatFilter.lua

# Tooltip
Modules\Tooltip\Tooltip.lua
Modules\Tooltip\TooltipID.lua
Modules\Tooltip\TooltipIcons.lua
Modules\Tooltip\TooltipItemLevel.lua
Modules\Tooltip\TooltipHoverTips.lua

# Skins
Modules\Skins\ObjectiveTracker.lua
Modules\Skins\CharacterFrames.lua
Modules\Skins\ChatBubbles.lua

# DataText
Modules\DataText\Stats.lua

# Maps
Modules\Maps\WorldMap.lua
Modules\Maps\MapRevealData.lua
Modules\Maps\MapReveal.lua
Modules\Maps\WowheadLink.lua

# Automation
Modules\Automation\AutoVendor.lua
Modules\Automation\QuickQuest.lua
Modules\Automation\FasterLoot.lua
Modules\Automation\MovieSkip.lua
Modules\Automation\DeclineDuel.lua
